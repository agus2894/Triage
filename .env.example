# ==============================================================================
# 🏥 TRIAGE DIGITAL - CONFIGURACIÓN DE VARIABLES DE ENTORNO (TEMPLATE)
# ==============================================================================
# 📋 INSTRUCCIONES:
# 1. Copie este archivo como .env: cp .env.example .env
# 2. Complete con sus valores reales
# 3. NUNCA suba el archivo .env a Git (ya está en .gitignore)

# --- Configuración General de Django ---
SECRET_KEY=generar-una-secret-key-segura-aqui-usar-python-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,192.168.*,10.*,172.*

# --- Base de Datos PostgreSQL (SOLO para Producción) ---
# Deje estas variables comentadas o vacías para usar SQLite en desarrollo
# Descomente y complete SOLO en producción con credenciales reales:

# DB_NAME=nombre_base_datos
# DB_USER=usuario_base_datos
# DB_PASSWORD=password_seguro_aqui
# DB_HOST=host.base.datos.com
# DB_PORT=5432
# DB_SSLMODE=require

# --- Modo de Operación ---
# FORCE_OFFLINE=1 : Fuerza SQLite local (desarrollo)
# FORCE_OFFLINE=0 : Usa PostgreSQL si hay credenciales, sino SQLite (producción)
FORCE_OFFLINE=1

# --- Puerto de Ejecución (Opcional) ---
# TRIAGE_PORT=8000

